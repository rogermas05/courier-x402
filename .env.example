# Created for you by `npm run wallets`. Never commit .env.
# The seller receives AUSD, submits payments (paying the gas) and sends refunds.
SELLER_PRIVATE_KEY=
# The paying agent. Holds AUSD only; it never needs ETH.
BUYER_PRIVATE_KEY=

# ── API ──────────────────────────────────────────────────────────────
PORT=4021
# RPC_URL=https://sepolia.base.org
PRICE_BASE_AUSD=0.05
PRICE_PER_MINUTE_AUSD=0.05

# Summarises transcripts into an outcome. Without it, the raw transcript is returned.
ANTHROPIC_API_KEY=
# MODEL_ID=claude-sonnet-5-5

# Telephony: mock | elevenlabs | telnyx. "mock" dials nothing and says so in every transcript.
TELEPHONY_PROVIDER=mock

# ElevenLabs voice agents, calling out over a Telnyx SIP trunk.
# `npm run setup:elevenlabs` creates the trunk and fills in the last three.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2
# ELEVENLABS_LLM=claude-sonnet-4-6
# ELEVENLABS_PHONE_NUMBER_ID=
# TELNYX_SIP_USERNAME=
# TELNYX_SIP_PASSWORD=

# Telnyx: the line ElevenLabs calls through, or a voice agent of its own with TELEPHONY_PROVIDER=telnyx.
# TELNYX_API_KEY=
# TELNYX_FROM_NUMBER=
# TELNYX_TEXML_APP_ID=
# TELNYX_VOICE=
# TELNYX_VOICE_API_KEY_REF=
# TELNYX_MODEL=
# TELNYX_MODEL_API_KEY_REF=
# With real telephony, only these numbers can be dialed. Empty means none.
DISPATCH_ALLOWED_NUMBERS=

# ── Paying agent (CLI and MCP) ───────────────────────────────────────
DISPATCH_URL=http://localhost:4021
# The agent refuses to sign any single payment above this.
MAX_PER_CALL_AUSD=2
